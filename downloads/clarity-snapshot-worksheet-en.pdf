<!doctype html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Clarity Snapshot — Worksheet | Seipsum</title>
<style>
  :root {
    --ink: #111111;
    --amber: #D9A441;
    --paper: #ffffff;
    --line: #111111;
    --muted: #555555;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { background: #e8e8e8; }
  body {
    font-family: Georgia, "Times New Roman", serif;
    color: var(--ink);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .page {
    width: 210mm;
    min-height: 297mm;
    background: var(--paper);
    margin: 10mm auto;
    padding: 22mm 20mm;
    position: relative;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
    page-break-after: always;
    display: flex;
    flex-direction: column;
  }
  .page:last-child { page-break-after: auto; }
  @page { size: A4; margin: 0; }
  @media print {
    html { background: none; }
    .page { margin: 0; box-shadow: none; }
  }

  /* brand marks */
  .brandbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 3px solid var(--ink);
    padding-bottom: 6mm;
  }
  .brandbar .wordmark { font-size: 13pt; letter-spacing: .12em; }
  .melt { display: block; }

  .footer-mark {
    margin-top: auto;
    padding-top: 6mm;
    border-top: 1px solid var(--ink);
    display: flex;
    justify-content: space-between;
    font-size: 8.5pt;
    color: var(--muted);
  }

  h1 { font-size: 30pt; line-height: 1.15; margin: 16mm 0 6mm; }
  h1 .thin { display: block; font-size: 15pt; font-weight: normal; font-style: italic; margin-top: 5mm; color: var(--muted); }
  h2 { font-size: 15pt; margin-bottom: 5mm; padding-left: 4mm; border-left: 5px solid var(--amber); }
  h3 { font-size: 11.5pt; margin: 7mm 0 2.5mm; }
  p { font-size: 10.5pt; line-height: 1.55; margin-bottom: 3.5mm; }
  .lede { font-size: 12pt; }
  .amber-chip {
    display: inline-block;
    background: var(--amber);
    color: var(--ink);
    font-size: 8.5pt;
    letter-spacing: .18em;
    padding: 1.5mm 4mm;
    margin-bottom: 4mm;
  }

  /* worksheet elements */
  .writebox {
    border: 1.5px solid var(--ink);
    min-height: 34mm;
    padding: 4mm;
  }
  .writebox.tall { min-height: 58mm; }
  .writebox .ruled { border-bottom: 1px solid #bbb; height: 9mm; }
  .rating { display: flex; gap: 6mm; margin: 4mm 0 2mm; }
  .rating label {
    border: 1.5px solid var(--ink);
    padding: 3mm 8mm;
    font-size: 10.5pt;
    display: flex;
    align-items: center;
    gap: 3mm;
  }
  .rating .box {
    width: 4.5mm; height: 4.5mm;
    border: 1.5px solid var(--ink);
    display: inline-block;
  }
  .elements-table { width: 100%; border-collapse: collapse; margin-top: 2mm; }
  .elements-table th {
    font-size: 9pt; letter-spacing: .08em; text-align: left;
    border-bottom: 2px solid var(--ink);
    padding: 2.5mm 3mm;
  }
  .elements-table td {
    border-bottom: 1px solid #bbb;
    padding: 0 3mm;
    height: 10mm;
    font-size: 10pt;
  }
  .elements-table td.c1 { width: 62%; }
  .elements-table td.c2 { width: 19%; }
  .elements-table td.c3 { width: 19%; }
  .beat-label { font-size: 9pt; letter-spacing: .15em; color: var(--muted); margin-bottom: 1.5mm; }

  .two-col { display: flex; gap: 8mm; margin-top: 4mm; }
  .two-col > div { flex: 1; border: 1.5px solid var(--ink); padding: 4mm; min-height: 40mm; }
  .two-col h3 { margin-top: 0; }
</style>
</head>
<body>

<!-- PAGE 1 — COVER -->
